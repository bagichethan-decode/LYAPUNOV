class Solution {
    public int[] intersectionArray(int[] nums1, int[] nums2) {
        int i = 0, j = 0;
        int[] result = new int[Math.min(nums1.length, nums2.length)];
        int k = 0;

        while (i < nums1.length && j < nums2.length) {
            if (nums1[i] == nums2[j]) {
                result[k++] = nums1[i];
                i++;
                j++;
            } else if (nums1[i] < nums2[j]) {
                i++;
            } else {
                j++;
            }
        }

        return java.util.Arrays.copyOf(result, k);
    }
}
