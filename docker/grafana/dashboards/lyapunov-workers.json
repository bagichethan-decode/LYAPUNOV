{
  "title": "LYAPUNOV Worker Monitoring",
  "uid": "lyapunov-workers",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "title": "Worker Availability",
      "type": "stat",
      "gridPos": {"h": 5, "w": 8, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "lyapunov_worker_up", "refId": "A"}]
    },
    {
      "id": 2,
      "title": "Stale Workers",
      "type": "stat",
      "gridPos": {"h": 5, "w": 8, "x": 8, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "lyapunov_worker_stale", "refId": "A"}]
    },
    {
      "id": 3,
      "title": "Published Events",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "lyapunov_worker_published_total", "refId": "A"}]
    },
    {
      "id": 4,
      "title": "Failed Events",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "lyapunov_worker_failed_total", "refId": "A"}]
    },
    {
      "id": 5,
      "title": "Last Worker Heartbeat",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 13},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "time() - lyapunov_worker_last_seen_timestamp_seconds", "refId": "A"}]
    }
  ]
}
